{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "system"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "terminal": true,
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": false,
    "permissions": "prompt"
  },
  "tabs": {
    "enabled": true,
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "diffs": {
    "view": "auto"
  },
  "terminal": {
    "title": true
  },
  "plugins": [
    "@mynameistito/opencode-usage-limits"
  ]
}
